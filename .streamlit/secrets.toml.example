# Copy this file to `secrets.toml` in the same directory and fill in your key.
# `secrets.toml` is gitignored — never commit your real key.
#
# For deployed apps on Streamlit Community Cloud, set these in the app's
# Settings → Secrets dashboard instead of shipping a file.

ANTHROPIC_API_KEY = "sk-ant-..."

# Optional. Defaults to "anthropic". Future values: "gemini" (not yet implemented).
LLM_PROVIDER = "anthropic"
